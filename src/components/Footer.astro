---
import { AUTHOR, SITE, SOCIAL } from "../config";

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap site-footer__inner">
    <p class="site-footer__legal">
      © {year} <a href={AUTHOR.url} target="_blank" rel="noopener">{AUTHOR.name}</a>. All rights reserved.
    </p>

    <div class="site-footer__right">
      <ul class="site-footer__social">
        {
          SOCIAL.map((link) => (
            <li>
              <a href={link.href} rel="noopener" target="_blank">
                {link.label}
              </a>
            </li>
          ))
        }
        <li><a href="/sitemap.xml">Sitemap</a></li>
      </ul>

      <p class="site-footer__credits">
        Built with <a href="https://github.com/em-dash-cms/emdash" target="_blank" rel="noopener">EmDash</a> · Theme <a href="https://github.com/kpab/astro-sumi" target="_blank" rel="noopener">Sumi</a> by <a href="https://github.com/kpab" target="_blank" rel="noopener">kpab</a>
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--section-y);
    border-top: var(--rule-width) solid var(--color-rule);
  }

  .site-footer__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4) var(--space-8);
    padding-block: var(--space-8);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-fg-faint);
  }

  .site-footer__legal {
    margin: 0;
  }

  .site-footer__right {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: var(--space-2);
  }

  .site-footer__credits {
    font-size: 0.7rem;
    opacity: 0.8;
  }

  .site-footer__social {
    display: flex;
    gap: var(--space-6);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-footer a {
    text-decoration: none;
  }

  .site-footer a:hover {
    color: var(--color-accent);
  }

  @media (max-width: 40rem) {
    .site-footer__inner {
      flex-direction: column;
      justify-content: center;
      align-items: center;
      text-align: center;
      gap: var(--space-4);
    }

    .site-footer__right {
      align-items: center;
      text-align: center;
    }

    .site-footer__social {
      justify-content: center;
    }

    .site-footer__legal {
      text-align: center;
      order: 2;
    }
  }
</style>
