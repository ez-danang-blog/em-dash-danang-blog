---
import { getMenu, getSiteSettings } from "emdash";
import { NAV, SITE } from "../config";
import ThemeToggle from "./ThemeToggle.astro";

interface Props {
  /** Lay the header over the hero instead of pushing it down. */
  overlay?: boolean;
}

const { overlay = false } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, "") || "/";

const isCurrent = (href: string) => path === href || (href !== "/" && path.startsWith(`${href}/`));

const settings = await getSiteSettings().catch(() => null);
const menu = await getMenu("primary").catch(() => null);

const siteTitle = settings?.title || SITE.title;
const tagline = settings?.tagline || SITE.tagline;

const navItems = menu?.items?.length
  ? menu.items.map((item: any) => ({ label: item.label, href: item.url || item.href }))
  : NAV;
---

<header class="site-header" data-overlay={overlay ? "" : undefined}>
  <a class="brand" href="/">
    <span class="brand__mark">EZ <span class="nowrap">Da&#8201;Nang</span></span>
  </a>

  <div class="site-header__end">
    <nav class="nav" aria-label="Primary">
      <ul class="nav__list">
        {
          navItems.map((item: any) => (
            <li>
              <a
                href={item.href}
                aria-current={isCurrent(item.href) ? "page" : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <ThemeToggle />
  </div>
</header>

<style>
  .site-header {
    position: relative;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-6) var(--gutter);
  }

  .site-header[data-overlay] {
    position: absolute;
    inset-inline: 0;
    top: 0;
  }

  .brand {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    text-decoration: none;
  }

  .brand:hover {
    color: inherit;
  }

  .brand__mark {
    font-family: var(--font-mono);
    font-size: 1.1875rem;
    font-weight: 600;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  .brand__sub {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-fg-faint);
  }

  .site-header__end {
    display: flex;
    align-items: center;
    gap: clamp(var(--space-4), 3vw, var(--space-8));
  }

  .nav__list {
    display: flex;
    align-items: center;
    gap: clamp(var(--space-4), 3vw, var(--space-8));
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav__list a {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-fg-muted);
    text-decoration: none;
    transition: color var(--transition);
  }

  .nav__list a:hover,
  .nav__list a[aria-current="page"] {
    color: var(--color-fg);
  }

  .nav__list a[aria-current="page"] {
    text-decoration: underline;
    text-decoration-color: var(--color-accent);
    text-decoration-thickness: var(--rule-width);
    text-underline-offset: 0.35em;
  }

  @media (max-width: 40rem) {
    .brand__sub {
      display: none;
    }
  }
</style>
