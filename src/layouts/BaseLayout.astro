---
import "../styles/fonts.css";
import "../styles/global.css";

import BaseHead, { type ArticleMeta } from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import CoffeeWidget from "../components/CoffeeWidget.astro";
import { SITE } from "../config";
import { getSiteSettings } from "emdash";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  article?: ArticleMeta;
  overlayHeader?: boolean;
}

const {
  title,
  description = SITE.description,
  ogImage,
  article,
  overlayHeader = false,
} = Astro.props;

const settings = await getSiteSettings().catch(() => null);
const siteTitle = settings?.title || SITE.title;
const tagline = settings?.tagline || SITE.tagline;

const pageTitle = title
  ? `${title} — ${siteTitle}`
  : `${siteTitle} — ${tagline}`;
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <BaseHead
      title={pageTitle}
      description={description}
      ogImage={ogImage}
      article={article}
    />
    <slot name="head" />
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header overlay={overlayHeader} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <CoffeeWidget />
  </body>
</html>
