---
import "../styles/fonts.css";
import "../styles/global.css";

import BaseHead, { type ArticleMeta } from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { SITE } from "../config";
import { getSiteSettings } from "emdash";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  article?: ArticleMeta;
  overlayHeader?: boolean;
}

const {
  title,
  description = SITE.description,
  ogImage,
  article,
  overlayHeader = false,
} = Astro.props;

const settings = await getSiteSettings().catch(() => null);
const siteTitle = settings?.title || SITE.title;
const tagline = settings?.tagline || SITE.tagline;

const pageTitle = title
  ? `${title} — ${siteTitle}`
  : `${siteTitle} — ${tagline}`;
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <BaseHead
      title={pageTitle}
      description={description}
      ogImage={ogImage}
      article={article}
    />
    <slot name="head" />
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header overlay={overlayHeader} />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script
      is:inline
      data-name="BMC-Widget"
      data-cfasync="false"
      src="https://cdnjs.buymeacoffee.com/1.0.0/widget.prod.min.js"
      data-id="evgeniizinner"
      data-description="Support me on Buy me a coffee!"
      data-message="If you find these Da Nang guides helpful, consider supporting this blog with a coffee!"
      data-color="#FFDD00"
      data-position="Right"
      data-x_margin="18"
      data-y_margin="18"
    ></script>
  </body>
</html>
