{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "em-dash-danang-blog",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-02-24",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "./dist" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "em-dash-danang-blog-db",
      "database_id": "07d74376-0d07-4610-80fd-ceca4552f782"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "em-dash-danang-blog-media"
    }
  ]
}
